@page "/"
@inject MedicalAdvisorService AdvisorService
@inject ConversationState ConversationState
@inject ThemeService ThemeService
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Diabetologický poradce</PageTitle>

<div class="chat-container">
    <div class="chat-messages" id="chat-messages" @onscroll="OnScroll">
        <MudContainer MaxWidth="MaxWidth.Medium">
            @foreach (var message in ConversationState.Messages)
            {
                <ChatMessageBubble Message="message" />

                @* Welcome cards -- shown after the first (welcome) message *@
                @if (message == ConversationState.Messages[0] && _showWelcomeCards)
                {
                    <WelcomeCards OnTopicSelected="OnTopicSelected" />
                }

                @* Quick-reply buttons -- shown below assistant messages that have them *@
                @if (message.Role == ChatRole.Assistant
                     && message.QuickReplies.Count > 0
                     && message.ShowQuickReplies
                     && !_isStreaming)
                {
                    <QuickReplyButtons Replies="message.QuickReplies"
                                       Disabled="_isStreaming"
                                       OnReplySelected="OnQuickReplySelected" />
                }
            }
        </MudContainer>
    </div>

    <ScrollToBottomFab Visible="_showScrollFab" OnClick="OnScrollToBottomClicked" />

    <div class="chat-input-area">
        <MudContainer MaxWidth="MaxWidth.Medium">
            <div class="input-pill">
                <MudIcon Icon="@Icons.Material.Filled.ChatBubbleOutline" Class="input-pill-icon" />
                <MudTextField @ref="_inputField"
                              @bind-Value="_userInput"
                              Placeholder="Napište svou zprávu..."
                              Variant="Variant.Text"
                              Sizing="InputSizing.Auto"
                              MaxLines="5"
                              Disabled="_isStreaming"
                              Immediate="true"
                              OnKeyDown="OnKeyDown"
                              Class="flex-grow-1"
                              Style="font-size: 15px;" />
                <MudIconButton Icon="@Icons.Material.Filled.Send"
                               Color="Color.Primary"
                               Variant="Variant.Filled"
                               OnClick="SendMessage"
                               Disabled="@(_isStreaming || string.IsNullOrWhiteSpace(_userInput))"
                               Class="send-button" />
            </div>
        </MudContainer>
    </div>
</div>

@code {
    private string _userInput = string.Empty;
    private bool _isStreaming;
    private bool _showWelcomeCards = true;
    private bool _showScrollFab;
    private bool _shouldScrollToBottom;
    private bool _userScrolledUp;
    private MudTextField<string>? _inputField;
    private CancellationTokenSource? _cts;

    [CascadingParameter]
    public MainLayout? Layout { get; set; }

    protected override void OnInitialized()
    {
        ThemeService.OnThemeChanged += OnThemeChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Scroll to bottom on initial load only.
            await ScrollToBottom();
        }
        else if (_shouldScrollToBottom && !_userScrolledUp)
        {
            _shouldScrollToBottom = false;
            await ScrollToBottom();
        }
    }

    private void OnThemeChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }

    private async Task OnTopicSelected(string topic)
    {
        _showWelcomeCards = false;
        await SendMessageText(topic);
    }

    private async Task OnQuickReplySelected(string reply)
    {
        // Hide quick replies on all messages when one is selected.
        foreach (var msg in ConversationState.Messages)
        {
            msg.ShowQuickReplies = false;
        }
        await SendMessageText(reply);
    }

    private async Task SendMessage()
    {
        var input = _userInput?.Trim();
        if (string.IsNullOrWhiteSpace(input) || _isStreaming)
            return;

        _userInput = string.Empty;
        _showWelcomeCards = false;

        // Hide quick replies on all messages when user types manually.
        foreach (var msg in ConversationState.Messages)
        {
            msg.ShowQuickReplies = false;
        }

        await SendMessageText(input);
    }

    private async Task SendMessageText(string input)
    {
        if (_isStreaming) return;

        _isStreaming = true;
        _userScrolledUp = false;

        // Add user message to UI display list only (service manages ChatHistory).
        ConversationState.Messages.Add(new ChatMessage
        {
            Role = ChatRole.User,
            Content = input,
            Timestamp = DateTime.Now,
        });
        RequestScrollToBottom();
        StateHasChanged();

        // Create placeholder streaming message for UI.
        var streamingMessage = new ChatMessage
        {
            Role = ChatRole.Assistant,
            Content = string.Empty,
            Timestamp = DateTime.Now,
            IsStreaming = true
        };
        ConversationState.Messages.Add(streamingMessage);
        RequestScrollToBottom();
        StateHasChanged();

        _cts = new CancellationTokenSource();

        try
        {
            await foreach (var chunk in AdvisorService.StreamResponseAsync(input, ConversationState, streamingMessage, _cts.Token))
            {
                streamingMessage.Content += chunk;
                RequestScrollToBottom();
                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
            // Streaming was cancelled
        }
        catch (Exception ex)
        {
            streamingMessage.Content += $"\n\n[Chyba: {ex.Message}]";
        }
        finally
        {
            streamingMessage.IsStreaming = false;
            _isStreaming = false;
            _userScrolledUp = false;
            _cts?.Dispose();
            _cts = null;
            RequestScrollToBottom();
            StateHasChanged();

            // Auto-save conversation after each completed response.
            if (Layout is not null)
                await Layout.SaveCurrentSessionAsync();
        }
    }

    private void RequestScrollToBottom()
    {
        _shouldScrollToBottom = true;
    }

    private async Task OnScrollToBottomClicked()
    {
        _userScrolledUp = false;
        await ScrollToBottom();
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await JS.InvokeVoidAsync("eval",
                "document.getElementById('chat-messages')?.scrollTo({top: document.getElementById('chat-messages').scrollHeight, behavior: 'smooth'})");
        }
        catch
        {
            // Ignore JS interop errors during prerendering
        }
    }

    private async Task OnScroll()
    {
        try
        {
            var isAtBottom = await JS.InvokeAsync<bool>("eval",
                "(function() { var el = document.getElementById('chat-messages'); if (!el) return true; return el.scrollHeight - el.scrollTop - el.clientHeight < 100; })()");
            var newValue = !isAtBottom;
            if (_showScrollFab != newValue)
            {
                _showScrollFab = newValue;
                StateHasChanged();
            }

            // If user scrolls up during streaming, pause auto-scroll.
            if (_isStreaming && !isAtBottom)
            {
                _userScrolledUp = true;
            }
        }
        catch
        {
            // Ignore JS interop errors during prerendering
        }
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= OnThemeChanged;
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
