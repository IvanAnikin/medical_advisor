@using System.Text.RegularExpressions

<div class="message-row @(IsUser ? "user-row" : "assistant-row")">
    <div class="message-avatar">
        @if (IsUser)
        {
            <MudIcon Icon="@Icons.Material.Filled.Person" />
        }
        else
        {
            <MudIcon Icon="@Icons.Material.Filled.LocalHospital" />
        }
    </div>
    <div class="@BubbleClass">
        @if (Message.IsStreaming && string.IsNullOrEmpty(Message.Content))
        {
            <TypingIndicator />
        }
        else
        {
            <span class="message-text">
                @((MarkupString)RenderContent(Message.Content))
            </span>
        }
        <div class="message-timestamp">
            @Message.Timestamp.ToString("HH:mm")
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public ChatMessage Message { get; set; } = default!;

    private bool IsUser => Message.Role == ChatRole.User;

    private string BubbleClass => IsUser
        ? "message-bubble user-bubble"
        : "message-bubble assistant-bubble";

    private static string RenderContent(string content)
    {
        if (string.IsNullOrEmpty(content))
            return string.Empty;

        var escaped = System.Net.WebUtility.HtmlEncode(content);

        // Bold: **text**
        escaped = Regex.Replace(escaped, @"\*\*(.+?)\*\*", "<strong>$1</strong>");

        // Italic: *text*
        escaped = Regex.Replace(escaped, @"(?<!\*)\*(?!\*)(.+?)(?<!\*)\*(?!\*)", "<em>$1</em>");

        // Newlines
        escaped = escaped.Replace("\n", "<br />");

        return escaped;
    }
}
