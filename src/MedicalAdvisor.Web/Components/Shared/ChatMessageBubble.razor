@using System.Text.RegularExpressions

<div class="message-row @(IsUser ? "user-row" : "assistant-row")">
    <div class="message-avatar">
        @if (IsUser)
        {
            <MudIcon Icon="@Icons.Material.Filled.Person" />
        }
        else
        {
            <MudIcon Icon="@Icons.Material.Filled.LocalHospital" />
        }
    </div>
    <div class="@BubbleClass">
        @if (Message.IsStreaming && string.IsNullOrEmpty(Message.Content))
        {
            <TypingIndicator />
        }
        else
        {
            <span class="message-text">
                @((MarkupString)RenderContent(Message.Content))
            </span>

            @if (Message.Role == ChatRole.Assistant && Message.HasDoseGuidanceWarning)
            {
                <div class="message-flag message-warning-banner">
                    <MudIcon Icon="@Icons.Material.Filled.Info" Class="message-flag-icon" />
                    @if (Message.AdvisorId == "diabetes-2")
                    {
                        <span class="dose-warning-text" style="white-space: pre-line;">@GetDiabetes2DisclaimerText()</span>
                    }
                    else
                    {
                        <span>@GetDoseWarningText()</span>
                    }
                </div>
            }

            @if (Message.Role == ChatRole.Assistant && Message.ShowEmergencyCallButton)
            {
                <a class="message-flag message-emergency-button" href="tel:155">
                    <MudIcon Icon="@Icons.Material.Filled.Call" Class="message-flag-icon" />
                    <span>@GetEmergencyButtonText()</span>
                </a>
            }

        }
        <div class="message-timestamp">
            @Message.Timestamp.ToString("HH:mm")
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public ChatMessage Message { get; set; } = default!;

    private bool IsUser => Message.Role == ChatRole.User;

    private string BubbleClass => IsUser
        ? "message-bubble user-bubble"
        : "message-bubble assistant-bubble";

    private static string RenderContent(string content)
    {
        if (string.IsNullOrEmpty(content))
            return string.Empty;

        var escaped = System.Net.WebUtility.HtmlEncode(content);

        // Bold: **text**
        escaped = Regex.Replace(escaped, @"\*\*(.+?)\*\*", "<strong>$1</strong>");

        // Italic: *text*
        escaped = Regex.Replace(escaped, @"(?<!\*)\*(?!\*)(.+?)(?<!\*)\*(?!\*)", "<em>$1</em>");

        // Newlines
        escaped = escaped.Replace("\n", "<br />");

        return escaped;
    }

    private string GetDoseWarningText()
    {
        return DoseWarningHelpers.GetShortDoseWarningText(Message.DetectedLanguage);
    }

    private string GetDiabetes2DisclaimerText()
    {
        return DoseWarningHelpers.GetDiabetes2DisclaimerText();
    }

    private string GetEmergencyButtonText()
    {
        return GetNormalizedLanguage() switch
        {
            "cs" => "Volat 155",
            _ => "Call 155"
        };
    }

    private string GetNormalizedLanguage()
    {
        if (string.IsNullOrWhiteSpace(Message.DetectedLanguage))
            return "en";

        return Message.DetectedLanguage.StartsWith("cs", StringComparison.OrdinalIgnoreCase)
            ? "cs"
            : "en";
    }
}
