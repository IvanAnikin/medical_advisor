@inject AdvisorRegistry AdvisorRegistry
@inject NavigationManager NavigationManager
@inject ThemeService ThemeService

<MudIconButton Icon="@Icons.Material.Filled.Dashboard"
               Color="Color.Inherit"
               Size="Size.Small"
               title="Výběr poradce"
               OnClick="ToggleMenu" />

<MudPopover Open="_menuOpen" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft"
            Class="@($"advisor-selector-popover{(ThemeService.IsDarkMode ? " advisor-dark" : "")}")">
    <MudPaper Elevation="4" Class="pa-2" Style="min-width: 280px; max-width: 360px;">
        <MudText Typo="Typo.subtitle2" Class="px-2 pt-1 pb-2" Style="color: var(--text-secondary);">
            Vyberte poradce
        </MudText>
        @foreach (var advisor in AdvisorRegistry.GetAll())
        {
            <MudPaper Class="@GetItemClass(advisor)"
                      Elevation="0"
                      @onclick="() => SelectAdvisor(advisor)"
                      Style="cursor: pointer; transition: background 0.15s;">
                <div class="d-flex align-center gap-3 pa-2">
                    <MudIcon Icon="@GetAdvisorIcon(advisor.Icon)" Size="Size.Medium"
                             Color="@(advisor.Id == CurrentAdvisorId ? Color.Primary : Color.Default)" />
                    <div>
                        <MudText Typo="Typo.body1" Style="font-weight: 600;">@advisor.Name</MudText>
                        <MudText Typo="Typo.caption" Style="color: var(--text-secondary);">@advisor.Description</MudText>
                    </div>
                </div>
            </MudPaper>
        }
    </MudPaper>
</MudPopover>

@if (_menuOpen)
{
    <div class="advisor-selector-overlay" @onclick="CloseMenu"></div>
}

@code {
    private bool _menuOpen;

    [Parameter]
    public string CurrentAdvisorId { get; set; } = "";

    private void ToggleMenu() => _menuOpen = !_menuOpen;
    private void CloseMenu() => _menuOpen = false;

    private void SelectAdvisor(AdvisorConfig advisor)
    {
        _menuOpen = false;
        var url = advisor.IsDefault ? "/" : $"/{advisor.Slug}";
        NavigationManager.NavigateTo(url);
    }

    private string GetItemClass(AdvisorConfig advisor)
    {
        return advisor.Id == CurrentAdvisorId
            ? "advisor-item active rounded mb-1"
            : "advisor-item rounded mb-1";
    }

    private static string GetAdvisorIcon(string iconName) => iconName switch
    {
        "LocalHospital" => Icons.Material.Filled.LocalHospital,
        "PregnantWoman" => Icons.Material.Filled.PregnantWoman,
        "Chat" => Icons.Material.Filled.Chat,
        "MedicalServices" => Icons.Material.Filled.MedicalServices,
        "HealthAndSafety" => Icons.Material.Filled.HealthAndSafety,
        _ => Icons.Material.Filled.Chat,
    };
}
