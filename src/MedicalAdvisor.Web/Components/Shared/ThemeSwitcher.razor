@inject ThemeService ThemeService
@inject IJSRuntime JS
@implements IDisposable

<div class="theme-switcher">
    <span class="theme-sw-label">Klinický</span>
    <MudSwitch T="bool"
               Value="@(ThemeService.CurrentTheme == AppTheme.Friendly)"
               ValueChanged="OnStyleToggled"
               Color="Color.Primary"
               Size="Size.Small"
               Class="theme-sw-toggle" />
    <span class="theme-sw-label">Přátelský</span>

    <span class="theme-sw-divider"></span>

    <span class="theme-sw-label">Světlý</span>
    <MudSwitch T="bool"
               Value="@ThemeService.IsDarkMode"
               ValueChanged="OnDarkModeToggled"
               Color="Color.Primary"
               Size="Size.Small"
               Class="theme-sw-toggle" />
    <span class="theme-sw-label">Tmavý</span>
</div>

@code {
    private bool _initialized;

    protected override void OnInitialized()
    {
        ThemeService.OnThemeChanged += OnThemeChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadPreferencesFromCookies();
            _initialized = true;
        }
    }

    private async Task OnStyleToggled(bool isFriendly)
    {
        ThemeService.SetTheme(isFriendly ? AppTheme.Friendly : AppTheme.Clinical);
        if (_initialized) await SavePreferencesToCookies();
    }

    private async Task OnDarkModeToggled(bool isDark)
    {
        ThemeService.SetDarkMode(isDark);
        if (_initialized) await SavePreferencesToCookies();
    }

    private async Task LoadPreferencesFromCookies()
    {
        try
        {
            var themeCookie = await JS.InvokeAsync<string>("eval",
                "document.cookie.split('; ').find(c => c.startsWith('theme='))?.split('=')[1] || ''");
            var darkCookie = await JS.InvokeAsync<string>("eval",
                "document.cookie.split('; ').find(c => c.startsWith('darkMode='))?.split('=')[1] || ''");

            if (!string.IsNullOrEmpty(themeCookie) && Enum.TryParse<AppTheme>(themeCookie, out var theme))
                ThemeService.SetTheme(theme);

            if (!string.IsNullOrEmpty(darkCookie) && bool.TryParse(darkCookie, out var isDark))
                ThemeService.SetDarkMode(isDark);
        }
        catch
        {
            // JS interop not available during prerender
        }
    }

    private async Task SavePreferencesToCookies()
    {
        try
        {
            var maxAge = 365 * 24 * 60 * 60;
            await JS.InvokeVoidAsync("eval",
                $"document.cookie='theme={ThemeService.CurrentTheme};path=/;max-age={maxAge};SameSite=Lax'");
            await JS.InvokeVoidAsync("eval",
                $"document.cookie='darkMode={ThemeService.IsDarkMode.ToString().ToLowerInvariant()};path=/;max-age={maxAge};SameSite=Lax'");
        }
        catch
        {
            // JS interop not available during prerender
        }
    }

    private void OnThemeChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= OnThemeChanged;
    }
}
