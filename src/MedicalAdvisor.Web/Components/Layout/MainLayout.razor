@inherits LayoutComponentBase
@implements IDisposable
@inject ThemeService ThemeService

<MudThemeProvider Theme="ThemeService.CurrentMudTheme" IsDarkMode="ThemeService.IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="theme-root @ThemeService.ThemeCssClass">
    <div class="app-header @(_headerCollapsed ? "collapsed" : "")">
        @if (!_headerCollapsed)
        {
            <div class="app-header-row">
                <span class="app-bar-title">Diabetologický poradce</span>
            </div>
            <div class="app-header-row app-header-controls">
                <ThemeSwitcher />
            </div>
        }
        <button class="header-toggle" @onclick="ToggleHeader" title="@(_headerCollapsed ? "Zobrazit záhlaví" : "Skrýt záhlaví")">
            <span class="header-toggle-arrow @(_headerCollapsed ? "arrow-down" : "arrow-up")">&#9650;</span>
        </button>
    </div>
    <div class="app-body">
        @Body
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        ThemeService.OnThemeChanged += OnThemeChanged;
    }

    private bool _headerCollapsed;

    private void ToggleHeader()
    {
        _headerCollapsed = !_headerCollapsed;
    }

    private void OnThemeChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= OnThemeChanged;
    }
}
