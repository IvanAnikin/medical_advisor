@inherits LayoutComponentBase
@implements IDisposable
@inject ThemeService ThemeService

<MudThemeProvider Theme="ThemeService.CurrentMudTheme" IsDarkMode="ThemeService.IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="theme-root @ThemeService.ThemeCssClass">
    <MudLayout>
        <MudAppBar Elevation="0" Class="app-bar-custom">
            <span class="app-bar-title ml-3">Diabetologický poradce</span>
            <MudSpacer />
            <ThemeSwitcher />
        </MudAppBar>
        <MudMainContent Class="pa-0" Style="height: calc(100vh - var(--mud-appbar-height)); overflow: hidden;">
            @Body
        </MudMainContent>
    </MudLayout>
</div>

@code {
    protected override void OnInitialized()
    {
        ThemeService.OnThemeChanged += OnThemeChanged;
    }

    private void OnThemeChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= OnThemeChanged;
    }
}
