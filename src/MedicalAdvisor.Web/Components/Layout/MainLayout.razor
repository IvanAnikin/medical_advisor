@inherits LayoutComponentBase
@implements IDisposable
@inject ThemeService ThemeService

<MudThemeProvider Theme="ThemeService.CurrentMudTheme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h6" Class="ml-3">Diabetologický poradce</MudText>
        <MudSpacer />
        <ThemeSwitcher />
    </MudAppBar>
    <MudMainContent Class="pa-0" Style="height: calc(100vh - var(--mud-appbar-height)); overflow: hidden;">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    protected override void OnInitialized()
    {
        ThemeService.OnThemeChanged += OnThemeChanged;
    }

    private void OnThemeChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= OnThemeChanged;
    }
}
